# Biến dùng khi chạy Compose (copy vào backend/.env hoặc export trước khi up).
# Không commit secret.

POSTGRES_USER=edulit
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=edulit
POSTGRES_PORT=5433

# Host local (Nest/Next trên máy, chỉ DB trong Docker):
# DATABASE_URL=postgresql://edulit:replace_me@localhost:5433/edulit
#
# API trong Compose dùng hostname nội bộ postgres:5432 (compose.yml tự gắn).

API_PORT=4000
WEB_PORT=3000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Entrypoint API
RUN_MIGRATIONS=1
# Seed: cd backend && npm run prisma:seed (trên host, không trong image prod)

AI_MODE=mock
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4.1-mini
