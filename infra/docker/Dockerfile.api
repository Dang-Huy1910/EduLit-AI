FROM python:3.12-slim-bookworm AS builder
WORKDIR /src
RUN pip install --no-cache-dir uv
COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
COPY backend/_prompt_build.py ./_prompt_build.py
COPY backend/app ./app
RUN uv sync --no-dev --frozen

FROM python:3.12-slim-bookworm
WORKDIR /app
RUN useradd --create-home --uid 10001 edulit \
    && apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/.venv /app/.venv
COPY backend/app /app/app
COPY backend/alembic /app/alembic
COPY backend/alembic.ini /app/alembic.ini
COPY backend/pyproject.toml /app/pyproject.toml
COPY backend/scripts /app/scripts
COPY docs /docs
COPY frontend/src/lib/mock/roster_11a14.json /app/demo_frontend/src/lib/mock/roster_11a14.json
COPY frontend/src/lib/mock/submissionsManifest.ts /app/demo_frontend/src/lib/mock/submissionsManifest.ts
COPY frontend/public/submissions /app/demo_frontend/public/submissions
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEMO_FRONTEND_ROOT=/app/demo_frontend
USER edulit
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:4000/api/health')"
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-4000}"]
