{
  "$id": "https://edulit.local/schemas/socratic-outline-init.v1.json",
  "title": "SocraticOutlineInitOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["welcomeSentences", "outline"],
  "properties": {
    "welcomeSentences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "points"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 40 },
              "title": { "type": "string", "minLength": 1, "maxLength": 80 },
              "points": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": { "type": "string", "minLength": 1, "maxLength": 400 }
              }
            }
          }
        }
      }
    }
  }
}
