{
  "$id": "https://edulit.local/schemas/assessment-output.v1.json",
  "title": "AssessmentModelOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["detailedEvaluations", "totalScore"],
  "properties": {
    "detailedEvaluations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "awardedScore",
          "comment",
          "strengths",
          "weaknesses",
          "evidence",
          "missingElements"
        ],
        "properties": {
          "criterionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "awardedScore": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "pattern": "^-?[0-9]+(\\.[0-9]{1,2})?$"
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "strengths": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "weaknesses": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote", "start", "end"],
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "missingElements": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "totalScore": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^-?[0-9]+(\\.[0-9]{1,2})?$"
    }
  }
}
