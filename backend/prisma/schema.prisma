generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TEACHER
  STUDENT

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED

  @@map("assignment_status")
}

enum SocraticSessionStatus {
  ACTIVE
  COMPLETED

  @@map("socratic_session_status")
}

enum ChatMessageRole {
  USER
  ASSISTANT

  @@map("chat_message_role")
}

enum AssessmentStatus {
  AI_DRAFT
  PUBLISHED

  @@map("assessment_status")
}

enum SubmissionSource {
  LEGACY_TEXT
  IMAGE_OCR

  @@map("submission_source")
}

enum SubmissionDraftStatus {
  DRAFT
  AWAITING_PRIVACY_REVIEW
  PRIVACY_RETURNED
  PRIVACY_APPROVED
  OCR_PROCESSING
  OCR_FAILED
  OCR_REVIEW
  CONFIRMED

  @@map("submission_draft_status")
}

enum OcrRevisionStatus {
  COMPLETED
  CONFIRMED
  SUPERSEDED

  @@map("ocr_revision_status")
}

enum OcrIssueStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@map("ocr_issue_status")
}

enum ObservationKind {
  STRENGTH
  WEAKNESS
  STYLE

  @@map("observation_kind")
}

enum ObservationStatus {
  PROVISIONAL
  SUPPORTED
  RESOLVED
  INVALIDATED

  @@map("observation_status")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginId      String     @unique @map("login_id")
  displayName  String     @map("display_name")
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            AuthSession[]
  taughtAssignments   Assignment[]         @relation("AssignmentTeacher")
  socraticSessions    SocraticSession[]
  submissions         Submission[]
  assignmentProgress  AssignmentProgress[]
  submissionDrafts    SubmissionDraft[] @relation("DraftStudent")
  privacyReviewedDrafts SubmissionDraft[] @relation("DraftPrivacyReviewer")
  writingObservations WritingObservation[]
  writingProfile      WritingProfile?

  @@map("users")
}

model AuthSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Assignment {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId            String           @map("teacher_id") @db.Uuid
  code                 String           @unique
  title                String
  instructions         String
  genre                String
  gradeLevel           Int              @map("grade_level")
  learningMaterialText String           @map("learning_material_text") @db.Text
  rubric               Json
  maxScore             Decimal          @map("max_score") @db.Decimal(8, 2)
  scoreStep            Decimal          @map("score_step") @db.Decimal(8, 2)
  status               AssignmentStatus @default(DRAFT)
  publishedAt          DateTime?        @map("published_at") @db.Timestamptz(6)
  dueAt                DateTime?        @map("due_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher          User              @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  socraticSessions SocraticSession[]
  submissions      Submission[]
  progress         AssignmentProgress[]
  submissionDrafts SubmissionDraft[]

  @@index([teacherId])
  @@index([status])
  @@map("assignments")
}

model AssignmentProgress {
  studentId     String     @map("student_id") @db.Uuid
  assignmentId  String     @map("assignment_id") @db.Uuid
  readAt        DateTime?  @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  student    User       @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([studentId, assignmentId])
  @@index([assignmentId])
  @@map("assignment_progress")
}

model SocraticSession {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String                @map("student_id") @db.Uuid
  assignmentId    String                @map("assignment_id") @db.Uuid
  contextSnapshot Json                  @map("context_snapshot")
  outline         Json
  outlineRevision Int                   @default(1) @map("outline_revision")
  status          SocraticSessionStatus @default(ACTIVE)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  student     User           @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment  Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messages    ChatMessage[]
  submissions Submission[]

  @@unique([studentId, assignmentId])
  @@unique([id, studentId, assignmentId])
  @@index([assignmentId])
  @@map("socratic_sessions")
}

model ChatMessage {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  sequence       Int
  role           ChatMessageRole
  content        String          @db.Text
  requestId      String?         @map("request_id")
  provider       String?         @map("provider")
  modelName      String?         @map("model_name")
  promptVersion  String?         @map("prompt_version")
  responseMode   String?         @map("response_mode")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  session SocraticSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sessionId, sequence])
  @@unique([sessionId, requestId, role])
  @@index([sessionId])
  @@map("chat_messages")
}

model Submission {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  assignmentId       String   @map("assignment_id") @db.Uuid
  socraticSessionId  String?  @map("socratic_session_id") @db.Uuid
  source             SubmissionSource @default(LEGACY_TEXT)
  sourceDraftId      String?  @unique @map("source_draft_id") @db.Uuid
  text               String   @db.Text
  contentHash        String   @map("content_hash")
  assignmentSnapshot Json     @map("assignment_snapshot")
  submittedAt        DateTime @map("submitted_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student         User             @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment      Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  socraticSession SocraticSession? @relation(fields: [socraticSessionId, studentId, assignmentId], references: [id, studentId, assignmentId], onDelete: Restrict, onUpdate: Restrict)
  assessment      Assessment?
  sourceDraft     SubmissionDraft? @relation(fields: [sourceDraftId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([studentId, assignmentId])
  @@unique([id, studentId])
  @@index([assignmentId])
  @@index([socraticSessionId])
  @@map("submissions")
}

model SubmissionDraft {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId            String                @map("student_id") @db.Uuid
  assignmentId         String                @map("assignment_id") @db.Uuid
  assignmentSnapshot   Json                  @map("assignment_snapshot")
  status               SubmissionDraftStatus @default(DRAFT)
  revision             Int                   @default(1)
  privacyReviewedById  String?               @map("privacy_reviewed_by_id") @db.Uuid
  privacyReviewedAt    DateTime?             @map("privacy_reviewed_at") @db.Timestamptz(6)
  privacyReturnReason  String?               @map("privacy_return_reason") @db.Text
  ocrAttempts          Int                   @default(0) @map("ocr_attempts")
  ocrLeaseUntil        DateTime?             @map("ocr_lease_until") @db.Timestamptz(6)
  ocrLeaseToken        String?               @map("ocr_lease_token")
  ocrErrorCode         String?               @map("ocr_error_code")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  student          User              @relation("DraftStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment       Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  privacyReviewer  User?             @relation("DraftPrivacyReviewer", fields: [privacyReviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pages            SubmissionDraftPage[]
  ocrRevisions     OcrRevision[]
  submission       Submission?

  @@unique([studentId, assignmentId])
  @@index([assignmentId, status])
  @@map("submission_drafts")
}

model SubmissionDraftPage {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftId          String          @map("draft_id") @db.Uuid
  pageIndex        Int             @map("page_index")
  originalFileId   String          @map("original_file_id")
  derivativeFileId String          @map("derivative_file_id")
  mimeType         String          @map("mime_type")
  contentHash      String          @map("content_hash")
  masks            Json            @default("[]")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  draft SubmissionDraft @relation(fields: [draftId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([draftId, pageIndex])
  @@index([draftId])
  @@map("submission_draft_pages")
}

model OcrRevision {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftId         String            @map("draft_id") @db.Uuid
  sourceRevision  Int               @map("source_revision")
  revision        Int               @map("revision")
  status          OcrRevisionStatus @default(COMPLETED)
  rawPages        Json              @map("raw_pages")
  correctedText   String            @map("corrected_text") @db.Text
  provider        String?           @map("provider")
  modelName       String?           @map("model_name")
  promptVersion   String?           @map("prompt_version")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  draft  SubmissionDraft @relation(fields: [draftId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issues OcrIssue[]

  @@unique([draftId, revision])
  @@index([draftId, sourceRevision])
  @@map("ocr_revisions")
}

model OcrIssue {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ocrRevisionId String         @map("ocr_revision_id") @db.Uuid
  reporterId    String         @map("reporter_id") @db.Uuid
  pageId        String?        @map("page_id") @db.Uuid
  segmentId     String?        @map("segment_id")
  reportedText  String         @map("reported_text") @db.Text
  note          String?        @db.Text
  status        OcrIssueStatus @default(OPEN)
  resolvedById  String?        @map("resolved_by_id") @db.Uuid
  resolvedAt    DateTime?      @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  ocrRevision OcrRevision @relation(fields: [ocrRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ocrRevisionId, status])
  @@map("ocr_issues")
}

model Assessment {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId        String           @unique @map("submission_id") @db.Uuid
  studentId           String           @map("student_id") @db.Uuid
  rubricSnapshot      Json             @map("rubric_snapshot")
  detailedEvaluations Json             @map("detailed_evaluations")
  totalScore          Decimal          @map("total_score") @db.Decimal(8, 2)
  aiDetailedEvaluations Json?          @map("ai_detailed_evaluations")
  aiTotalScore        Decimal?         @map("ai_total_score") @db.Decimal(8, 2)
  reviewedById        String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  reviewReason        String?          @map("review_reason") @db.Text
  reviewRevision      Int              @default(0) @map("review_revision")
  maxScore            Decimal          @map("max_score") @db.Decimal(8, 2)
  status              AssessmentStatus @default(AI_DRAFT)
  modelName           String           @map("model_name")
  provider            String?          @map("provider")
  responseMode        String?          @map("response_mode")
  promptVersion       String           @map("prompt_version")
  assessedAt          DateTime         @map("assessed_at") @db.Timestamptz(6)
  publishedAt         DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  submission   Submission           @relation(fields: [submissionId, studentId], references: [id, studentId], onDelete: Restrict, onUpdate: Restrict)
  observations WritingObservation[]

  @@unique([id, studentId])
  @@unique([submissionId, studentId])
  @@index([studentId])
  @@map("assessments")
}

model WritingObservation {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String            @map("student_id") @db.Uuid
  assessmentId  String            @map("assessment_id") @db.Uuid
  kind          ObservationKind
  featureKey    String            @map("feature_key")
  description   String
  genre         String
  evidenceQuote String            @map("evidence_quote") @db.Text
  evidenceStart Int               @map("evidence_start")
  evidenceEnd   Int               @map("evidence_end")
  status        ObservationStatus @default(PROVISIONAL)
  observedAt    DateTime          @map("observed_at") @db.Timestamptz(6)
  provider      String?           @map("provider")
  modelName     String?           @map("model_name")
  promptVersion String?           @map("prompt_version")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  student    User       @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assessment Assessment @relation(fields: [assessmentId, studentId], references: [id, studentId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([studentId, assessmentId, featureKey])
  @@index([studentId, observedAt])
  @@index([assessmentId])
  @@map("writing_observations")
}

model WritingProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String   @unique @map("student_id") @db.Uuid
  declaredGoals  Json     @map("declared_goals")
  summary        Json
  observationIds Json     @map("observation_ids")
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student User @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("writing_profiles")
}
