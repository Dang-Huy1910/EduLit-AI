# Copy to backend/.env. Do not commit real secrets.

# development | test | production
APP_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000

# PostgreSQL. Tests fail if DATABASE_URL_TEST is missing (no fallback to this URL).
DATABASE_URL=postgresql://edulit:edulit_dev@localhost:5433/edulit_auth
DATABASE_URL_TEST=postgresql://edulit:edulit_dev@localhost:5433/edulit_auth_test

SESSION_COOKIE_NAME=edulit_session
# Session cookie without Max-Age when rememberMe=false
SESSION_TTL_SECONDS_SHORT=1800
# Persistent cookie Max-Age when rememberMe=true
SESSION_TTL_SECONDS_LONG=1209600
# Leave empty to derive from APP_ENV (secure in production).
COOKIE_SECURE=

EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Rate limits (atomic on PostgreSQL, shared across processes).
# Local values allow a Playwright suite plus a couple of reruns.
# Production should stay at or below these; Playwright truncates buckets first.
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_ACCOUNT_MAX=8
RATE_LIMIT_REGISTER_IP_MAX=30
RATE_LIMIT_EMAIL_IP_MAX=20
RATE_LIMIT_EMAIL_ACCOUNT_MAX=10
RATE_LIMIT_VERIFY_IP_MAX=20
RATE_LIMIT_RESET_IP_MAX=10

# Comma-separated proxy IPs allowed to supply X-Forwarded-For. Empty = do not trust XFF.
TRUSTED_PROXY_IPS=

# Local/test: Mailpit (SMTP sink) on 1025. Production requires a real provider.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# none | starttls | tls
SMTP_TLS_MODE=none
SMTP_FROM=EduLit-AI <noreply@localhost>
SMTP_TIMEOUT_SECONDS=8
SMTP_RETRIES=1

# Operator-provisioned teacher persona (Cô Đặng Loan). Not a public mailbox.
BOOTSTRAP_TEACHER_LOGIN_ID=dang.loan
BOOTSTRAP_TEACHER_EMAIL=dang.loan@thptdanphuong.edu.vn
BOOTSTRAP_TEACHER_DISPLAY_NAME=Cô Đặng Loan
# Local prototype password. Production MUST set a unique secret; the well-known
# prototype value is rejected when APP_ENV=production.
BOOTSTRAP_TEACHER_PASSWORD=DanPhuong@2024
# Extra emails that map to the same seeded teacher (comma-separated). Optional.
BOOTSTRAP_TEACHER_EMAIL_ALIASES=

# Must stay false in production. There is no demo-login bypass.
ALLOW_DEMO_LOGIN=false

# ── AI Configuration ───────────────────────────────────────────────────────
# Provider: openai | gemini | fake
# IMPORTANT: You must set AI_MODEL to a valid model for the selected provider
AI_PROVIDER=openai
AI_MODEL=gpt-4o
# API keys - set the one for your chosen provider
OPENAI_API_KEY=
GEMINI_API_KEY=
# AI behavior settings
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=512
AI_MAX_RETRIES=2
# Prompt version for Socratic agent
SOCRATIC_PROMPT_VERSION=v1
# Teacher document import (MarkItDown + extract agent). Do not reuse Socratic output budget.
IMPORT_PROMPT_VERSION=v1
IMPORT_MAX_BYTES=8000000
IMPORT_MAX_MARKDOWN_CHARS=100000
IMPORT_MIN_TEXT_CHARS=40
IMPORT_CONVERT_TIMEOUT_SECONDS=30
IMPORT_AI_TIMEOUT_SECONDS=90
IMPORT_AI_MAX_OUTPUT_TOKENS=4096
IMPORT_AI_MAX_INPUT_CHARS=80000
IMPORT_STALE_SECONDS=300
# Handwritten OCR (vision). OCR_MODEL empty → use AI_MODEL of the current provider.
OCR_MODEL=
OCR_PROMPT_VERSION=v1
OCR_TIMEOUT_SECONDS=90
OCR_MAX_OUTPUT_TOKENS=4096
OCR_CONCURRENCY=1
OCR_LEASE_SECONDS=600
OCR_POLL_SECONDS=2
OCR_MAX_ATTEMPTS=3
OCR_WORKER_ENABLED=true
OCR_MAX_PAGES=4
OCR_MAX_PAGE_BYTES=8000000
OCR_MIN_EDGE=200
OCR_MAX_EDGE=8000
OCR_PROCESS_MAX_EDGE=2400
