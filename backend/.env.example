# Copy thành backend/.env và điền giá trị local. Không commit secret.
# Cwd lệnh database: backend/

NODE_ENV=development
PORT=4000

# PostgreSQL 17 qua Compose. Host port mặc định 5433 vì 5432 thường đã có dịch vụ.
POSTGRES_USER=edulit
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=edulit
POSTGRES_PORT=5433

# Nest chạy trên máy host → localhost:5433. API trong Compose → postgres:5432 (compose.yml gắn sẵn).
DATABASE_URL=postgresql://edulit:replace_me@localhost:5433/edulit
# Bắt buộc cho test; không được fallback sang DATABASE_URL.
DATABASE_URL_TEST=postgresql://edulit:replace_me@localhost:5433/edulit_test
# Shadow DB riêng cho prisma migrate dev; không trỏ vào DB dữ liệu.
SHADOW_DATABASE_URL=postgresql://edulit:replace_me@localhost:5433/edulit_shadow

# Mật khẩu tài khoản seed (Argon2id). Không log giá trị này.
DEV_SEED_PASSWORD=replace_me_seed_password
# Local: nút 1-click trên trang login dùng mật khẩu này ở backend, không đưa ra frontend.
# Mặc định bật khi NODE_ENV=development|test. Production để trống hoặc false.
ALLOW_DEMO_LOGIN=true

APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=edulit_session
# Cookie HttpOnly, Path=/, SameSite=Lax, host-only. Secure khi production HTTPS.
# Dev HTTP localhost: để COOKIE_SECURE trống hoặc false.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
JSON_BODY_LIMIT=64kb
# AI chỉ chạy từ backend. Không dùng NEXT_PUBLIC_*. Không commit key thật.
# Đổi LLM: sửa AI_PROVIDER=gemini|openai. Giữ nguyên cặp key/model bên dưới.
# Thứ tự model: SOCRATIC_MODEL/ASSESSMENT_MODEL/WRITING_PROFILE_MODEL/OCR_MODEL
# -> GEMINI_MODEL hoặc OPENAI_MODEL theo provider -> AI_MODEL (override chung)
# -> gemini-3.8-flash khi Gemini chưa khai model. OpenAI cần OPENAI_MODEL hoặc AI_MODEL.
AI_MODE=mock
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_me_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=replace_me_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
AI_MODEL=
SOCRATIC_MODEL=
ASSESSMENT_MODEL=
WRITING_PROFILE_MODEL=
OCR_MODEL=
# mock dùng adapter giả có provenance mock/*; live không tự đổi provider/model khi lỗi.
# Opt-in live smoke: SOCRATIC_LIVE=1 npm run socratic:live-smoke
SOCRATIC_LIVE=0
# Opt-in live smoke chấm bài: ASSESSMENT_LIVE=1 npm run assessment:live-smoke
ASSESSMENT_LIVE=0
# Opt-in live smoke hồ sơ văn phong: WRITING_PROFILE_LIVE=1 npm run writing-profile:live-smoke
WRITING_PROFILE_LIVE=0
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=var/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_TOTAL_BYTES=41943040
UPLOAD_MAX_PIXELS=25000000
GCS_BUCKET=
GCP_PROJECT_ID=
