# Template thiết kế; backend chưa có config loader hoặc entrypoint thực thi.
# Điền secret vào môi trường local/deploy, không commit giá trị thật.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://edulit:replace_me@localhost:5432/edulit
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=edulit_session
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MODE=mock
STORAGE_DRIVER=local
# Tính từ repository root, không phải backend cwd; config loader phải resolve rõ.
LOCAL_STORAGE_PATH=var/uploads
GCS_BUCKET=
GCP_PROJECT_ID=
