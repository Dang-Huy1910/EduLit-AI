{
  "name": "edulit-ai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:up": "docker compose --env-file .env -f ../infra/docker/compose.database.yml up -d --wait",
    "db:check": "tsx src/infrastructure/database/check-connection.ts",
    "db:setup": "npm run db:up && npm run prisma:generate && npm run prisma:migrate:deploy && npm run prisma:seed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-socratic-assets.ts && tsx scripts/copy-assessment-assets.ts && tsx scripts/copy-writing-profile-assets.ts",
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:db": "tsx scripts/run-db-tests.ts",
    "test:dist": "npm run build && tsx --test tests/socratic-dist-import.test.ts tests/assessment-dist-import.test.ts tests/writing-profile-dist-import.test.ts tests/http-dist.test.ts",
    "socratic:demo": "tsx scripts/socratic-demo.ts",
    "socratic:live-smoke": "tsx scripts/socratic-live-smoke.ts",
    "assessment:demo": "tsx scripts/assessment-demo.ts",
    "assessment:live-smoke": "tsx scripts/assessment-live-smoke.ts",
    "writing-profile:demo": "tsx scripts/writing-profile-demo.ts",
    "writing-profile:live-smoke": "tsx scripts/writing-profile-live-smoke.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "ocr:fixtures": "tsx scripts/write-ocr-fixtures.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "1.30.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "ajv": "8.17.1",
    "argon2": "0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "17.4.2",
    "openai": "7.32.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
