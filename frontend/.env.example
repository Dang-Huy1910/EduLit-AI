# Public origin of this Next.js app. Backend APP_ORIGIN must match.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Server-side rewrite target for /api/* (same-origin cookies).
API_PROXY_TARGET=http://localhost:4000

# Leave empty to call /api on the same origin via the rewrite above.
# Set only if the browser must talk to the API host directly (CORS).
NEXT_PUBLIC_API_BASE_URL=
